---
import Chat from '../components/Chat';
import '../styles/global.css';

export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ask questions about NFL stats and get answers from real data." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>football-chat</title>
    <!-- Follow the system light/dark setting. shadcn themes dark mode with a .dark class on <html>. -->
    <script is:inline>
      const media = matchMedia('(prefers-color-scheme: dark)');
      const apply = () => document.documentElement.classList.toggle('dark', media.matches);
      apply();
      media.addEventListener('change', apply);
    </script>
  </head>
  <body>
    <Chat client:load />
  </body>
</html>
